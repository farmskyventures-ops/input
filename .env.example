# =====================================================================
# Nia by Farmsky — Input Marketplace (Client Tenant of Equipment Gateway)
# =====================================================================
# Nia is a 100% feature port of the Equipment marketplace, re-themed for
# crop inputs (seeds, fertilizers, agrochemicals, tools). All catalog,
# users/roles, orders, logistics, vendor, disputes, reviews and analytics
# run LOCALLY. Only payment execution, wallet and refund settlement are
# DELEGATED to the Equipment Central Payment Gateway.

# --- Application identity ----------------------------------------------------
APP_NAME="Nia by Farmsky"
PUBLIC_APP_URL="https://nia.farmsky.africa"
PUBLIC_BASE_URL="https://nia.farmsky.africa"
NODE_ENV="production"
PORT=8791

# --- Local PostgreSQL (full ported schema) -----------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nia"
# PGSSLMODE=require   # set for managed Postgres (Render/Neon/etc.)

# --- Central Payment Gateway delegation --------------------------------------
# Presence of PAYMENT_CLIENT_KEY + CROSS_APP_HMAC_SECRET + PAYMENT_GATEWAY_URL
# switches mpesa/sasapay STK push into delegated mode (calls the Equipment
# gateway /payments/initiate instead of Daraja/SasaPay directly).
PAYMENT_GATEWAY_URL="https://equipment.farmsky.africa/api/v1"
CENTRAL_HOST_GATEWAY="https://equipment.farmsky.africa/api/v1"
PAYMENT_CLIENT_KEY="nia_farmsky_key"
# MUST equal app_clients.hmac_secret for nia_farmsky_key on the gateway.
# Generate with: openssl rand -hex 32
CROSS_APP_HMAC_SECRET="nia_sec_unique_secure_hmac_key_2026"

# --- Auth hashing (PBKDF2) ---------------------------------------------------
AUTH_HASH_ITERATIONS=120000
AUTH_HASH_KEYLEN=32
# AUTH_PEPPER=optional_extra_secret

# --- CI/CD deployment (optional) ---------------------------------------------
# EQUIPMENT_PAT=pat_equipment_host_token_here

# =====================================================================
# NOTE: The following LOCAL provider credentials are intentionally left
# blank on Nia — payment execution is delegated, so Nia never talks to
# Daraja/SasaPay directly. They remain here only for completeness/parity.
# =====================================================================
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# SASAPAY_CLIENT_ID=
# SASAPAY_CLIENT_SECRET=
# SASAPAY_MERCHANT_CODE=
